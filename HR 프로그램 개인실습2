    function drawNetworkDiagram() {
      const svg = document.getElementById('networkSvg');
      let html = '';

      // 연결선 그리기
      links.forEach(l => {
        const s = nodes.find(n => n.id === l.source);
        const t = nodes.find(n => n.id === l.target);
        const mx = (s.x + t.x) / 2;
        const my = (s.y + t.y) / 2;
        html += `
          <line x1="${s.x}" y1="${s.y}" x2="${t.x}" y2="${t.y}" stroke="#94A3B8" stroke-width="2" />
          <rect x="${mx - 28}" y="${my - 10}" width="56" height="20" rx="6" fill="#FFFFFF" stroke="#E2E8F0" />
          <text x="${mx}" y="${my + 4}" text-anchor="middle" font-size="10" fill="#475569" font-weight="600">${l.label}</text>
        `;
      });

      // 독립 부서 점선 구역 표시 (내부감사팀)
      html += `
        <rect x="495" y="45" width="170" height="145" rx="16" fill="#FFF7ED" stroke="#F97316" stroke-dasharray="5,5" />
        <text x="580" y="65" text-anchor="middle" font-size="11" fill="#C2410C" font-weight="700">연관 없음 (독립 부서)</text>
      `;

      // 노드 그리기
      nodes.forEach((n, idx) => {
        html += `
          <g style="cursor:pointer;" onclick="selectNetworkNode(${idx})">
            <rect x="${n.x - 65}" y="${n.y - 28}" width="130" height="56" rx="14" fill="${n.color}" />
            <text x="${n.x}" y="${n.y - 4}" text-anchor="middle" font-size="12" fill="#FFFFFF" font-weight="700">${n.id}</text>
            <text x="${n.x}" y="${n.y + 14}" text-anchor="middle" font-size="11" fill="#E0F2FE">${n.person}</text>
          </g>
        `;
      });

      svg.innerHTML = html;
    }

